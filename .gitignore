# Build output
# ==================================================
dist/
dist-ssr/
build/
coverage/
# Written by `tsc -b`, which the typecheck script runs in build mode so that the
# root solution config is what gets validated. Incremental state, not source.
*.tsbuildinfo

# ==================================================
# Environment
# ==================================================
.env
.env.*
!.env.example

backend/.env
backend/.env.*
# The template is not a secret and is referenced by the documented setup
# (`cp backend/.env.example backend/.env`), so it must stay committable.
!backend/.env.example

