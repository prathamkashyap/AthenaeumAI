# Environment template for the backend.
#
# Copy to a real environment file and fill it in:
#
#   cp backend/.env.example backend/.env
#
# `backend/.env` is ignored by git; this template is not, so it is always
# available in a fresh checkout. `docker-compose.yml` loads `./backend/.env`
# directly, so this file is what `docker compose up` expects to find.
#
# `backend/config/env.js` validates these at startup and exits the process if a
# required one is missing, so the backend will not start half-configured.

# ── Required ────────────────────────────────────────────────────────────────

# Groq API token. Required for quiz generation, mistake analysis, flashcard
# generation and tutoring. Without a working key the AI calls fail and those
# features fall back to template content rather than erroring.
GROQ_API_KEY=

# MongoDB connection string. Must point at a replica set: the quiz-generation
# transaction and the durable attempt claim are both refused on a standalone
# server. `docker compose up` supplies this automatically; it is only required
# here when running the backend outside Compose.
MONGODB_URI=mongodb://localhost:27017/athenaeum?replicaSet=rs0

# Secret used to sign and verify session tokens. Must be at least 8 characters.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────

# Model used for every AI feature. Defaults to `openai/gpt-oss-120b` when unset.
# This was a hard-coded constant in five call sites until Groq retired
# `llama-3.3-70b-versatile`, at which point quiz generation, mistake analysis,
# flashcard generation and tutoring all failed with 404 `model_not_found`. Set it
# here to move models without touching code.
#
# List what your key can actually reach with:
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
#
# Note that the currently available models are reasoning models, so each one
# spends part of its token budget reasoning before answering. A five-question
# quiz takes roughly two to four minutes end to end.
# GROQ_MODEL=openai/gpt-oss-120b

# Port the API listens on. Defaults to 3001.
PORT=3001

# Redis, used by the BullMQ queue. Defaults to localhost:6379. Compose supplies
# these for the `redis` service; set them only when running the backend directly.
REDIS_HOST=localhost
REDIS_PORT=6379
# ── Production only ───────────────────────────────────────────────────────────

# `REDIS_URL` takes a connection string and is what managed providers hand out.
# It wins over the host/port pair above when set. Compose supplies
# `REDIS_HOST`/`REDIS_PORT`, so leave the pair alone for local development.
# REDIS_URL=rediss://<user>:<password>@<host>:6379

# Comma-separated browser origins allowed to call the API. Under
# NODE_ENV=production this is the ONLY allow-list — there is no localhost
# fallback — so leaving it empty blocks every browser request. Set it to the
# deployed frontend origin, e.g. https://athenaeumai.tech.
# ALLOWED_ORIGINS=https://athenaeumai.tech

# The frontend's API root is a build-time variable, not a backend one. Set
# VITE_API_ROOT when building the production bundle; a production build with it
# unset throws at startup rather than silently addressing localhost.
# VITE_API_ROOT=https://api.athenaeumai.tech/api/v1
