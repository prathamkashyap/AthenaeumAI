# Environment template for the backend.
#
# Copy to a real environment file and fill it in:
#
#   cp backend/.env.example backend/.env
#
# `backend/.env` is ignored by git; this template is not, so it is always
# available in a fresh checkout. `docker-compose.yml` loads `./backend/.env`
# directly, so this file is what `docker compose up` expects to find.
#
# `backend/config/env.js` validates these at startup and exits the process if a
# required one is missing, so the backend will not start half-configured.

# ── Required ────────────────────────────────────────────────────────────────

# Groq API token. Required for quiz generation, mistake analysis, flashcard
# generation and tutoring. Without a working key the AI calls fail and those
# features fall back to template content rather than erroring.
GROQ_API_KEY=

# MongoDB connection string. Must point at a replica set: the quiz-generation
# transaction and the durable attempt claim are both refused on a standalone
# server. `docker compose up` supplies this automatically; it is only required
# here when running the backend outside Compose.
MONGODB_URI=mongodb://localhost:27017/athenaeum?replicaSet=rs0

# Secret used to sign and verify session tokens. Must be at least 8 characters.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────

# Port the API listens on. Defaults to 3001.
PORT=3001

# Redis, used by the BullMQ queue. Defaults to localhost:6379. Compose supplies
# these for the `redis` service; set them only when running the backend directly.
REDIS_HOST=localhost
REDIS_PORT=6379